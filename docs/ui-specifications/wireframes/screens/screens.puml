!procedure $finish_csv_upload_screen()
salt
{
    title Finish CSV Upload Screen

    Ontario Lab.csv

    {! 
        Dataset ODM Version | ^ODM version^
        ODM Table | ^Table^
    }

    [Upload]
    [Close]
}
