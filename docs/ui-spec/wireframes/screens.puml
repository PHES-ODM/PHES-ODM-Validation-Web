@startuml

!include ./components/components.puml

!procedure $top_bar($has_datasets = 0)
    {*
        **Upload Dataset** | **Datasets** | **View Validation Profiles** | **Tutorials**
        **Datasets** |
        !if $has_datasets
            Ontario Lab.csv | Hamilton Lab.xlsx
        !else
            No Dataset Uploaded
        !endif
    }

        ...
        ...
        ...
        ...
!endprocedure

!procedure $home_page()
salt
{
    title Home Page

    $top_bar(0)

    Welcome Text
}
!endprocedure

!procedure $upload_dataset_dialog()
salt
{
    title Upload Dataset Dialog

    Drag and drop or click to upload a file

    [Ok]
    [Cancel]
}
!endprocedure

!procedure $configure_dataset_dialog($file_name, $is_csv_file)
salt
{
    title Configure Dataset Dialog

    $file_name

    {^"Error Section"
        Error Text
    }

    ODM Version: | ^ODM version^

    !if ($is_csv_file)
        {!
            ODM Table | ^Table^
        }
    !else
        Tables
        {#
            Sheet Name | Table
            Sample | ^Table^
            lab | ^Table^ Ignore sheet^ Addresses^
        }
    !endif

    [Save]
    [Close]
}
!endprocedure

!procedure $view_dataset_page($file_name, $show_validations)
salt
{
    title View Dataset Page

    $top_bar(1)

    $sidebar($file_name, $show_validations) | {
        <File Name>
        {SI
            Validation Summary Text
            .
            .
            .
            .
        }
    }
}
!endprocedure

!procedure $validation_setup_dialog()
salt
{
    title Validation Setup Dialog
    "Name"
    { Choose validation profile | ^validation profile^^ ODM profile^ }
    ..
    ..

    {^"Validation Properties"
        Rules Selected: greater_than_max_length...
    }

    [Customize Validation]
    [Start Validation]
    [Cancel]
}
!endprocedure

!procedure $validation_progress_dialog()
salt
{
    title Validation Progress Dialog
    Validating <file_name>....
    [Cancel]
}
!endprocedure

!procedure $cancel_validation_dialog()
salt
{
    title Cancel Validation Dialog
    Are you sure you want to stop the validation process?
    [Yes]
    [No]
}
!endprocedure

!procedure $validation_summary_page()
salt
{
    title Validation Summary Page

    $top_bar(1)

    $sidebar("<File Name>", 1) |
    {^"Main Content"
        <File Name>
        {SI
            Validation Summary Text
            .
            .
            .
            .
        }
        [View Validation Report]
    }
}
!endprocedure

!procedure $view_validation_profiles_dialog()
salt
{
    title View Validation Profiles Dialog
    Validation Profile 1 | [Edit] | [Download] | [Delete]
    Validation Profile 2 | [Edit] | [Download] | [Delete]
    [Create New Profile]
    [Close]
}
!endprocedure

!procedure $delete_validation_profile_confirmation_dialog()
salt
{
    title Delete Validation Profile Confirmation Dialog
    Do you want to delete profile <profile_name>?
    [Yes]
    [No]
}
!endprocedure

!procedure $construct_validation_profile_form_dialog(\
    $dialog_title, $confirm_button_text, $add_upload_button\
)
salt
{
    title $dialog_title
    "Name "
    "Description "
    **Rules**: greater_than_max_length, less_than_min_value, ...
    [$confirm_button_text]

    !if ($add_upload_button)
    [Upload Profile]
    !endif

    [Cancel]
}
!endprocedure

!procedure $create_validation_profile_dialog()
    $construct_validation_profile_form_dialog("Create Validation Profile Dialog", "Create Profile", 1)
!endprocedure

!procedure $edit_validation_profile_dialog()
    $construct_validation_profile_form_dialog("Edit Validation Profile Dialog", "Save Profile", 0)
!endprocedure

!procedure $choose_validation_profile_dialog()
salt
{
    title Choose Validation Profile Dialog

    {T
        + Validation Profiles
            ++ MECP profile.yml
            ++ PHAC profile.yml
    }

    [Close]
}
!endprocedure

!procedure $validation_report_dialog()
salt
{
    title Validation Report Dialog

    <Full Validation Report Content>

    ^ Format ^^ CSV ^^ JSON ^^ YAML ^
    ..
    ..
    ..
    ..
    ..
    ..
    ^ Error Level ^^ WARNING ^^ ERROR ^^
    ..
    ..
    ..
    ..
    ..
    ..

    [Download]
    [Close]
}
!endprocedure

!procedure $duplicate_dataset_dialog()
salt
{
    title Duplicate Dataset Dialog

    We detected another dataset with the name <File Name> already uploaded to the tool.
    The tool currently does not allow two datasets with the same name to be
    uploaded. You can either:
    1. **Update the existing dataset**: This updates the current dataset in the
    tool with the new one. You won't lose any validations attached to the
    existing dataset, they will be moved over.
    2. **Replace the existing dataset**: This will delete the old dataset and
    any validations associated with it, replacing it with the new one.

    What do you want to do?

    [Update the Dataset]
    [Replace the Dataset]
}
!endprocedure

!procedure $replace_dataset_confirm_dialog()
salt
{
    title Replace Dataset Confirm Dialog

    Are you sure you want to replace the existing dataset? You will lose all
    data associated with it, including any validations.

    [No - Do not replace]
    [Yes - Replace the dataset]
}
!endprocedure


@enduml
