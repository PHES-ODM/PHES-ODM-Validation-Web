!procedure $construct_validation_profile_form_dialog(\
    $screen_title, $confirm_button_text, $add_upload_button\
)
salt
{
    title $screen_title 
    "Name "
    "Description "
    **Rules**: greater_than_max_length, less_than_min_value, ...
    [$confirm_button_text]

    !if ($add_upload_button) 
    [Upload Profile] 
    !endif

    [Cancel]
}
!endprocedure

!procedure $create_validation_profile_dialog()
    $construct_validation_profile_form_dialog("Create Validation Profile Dialog", "Create Profile", 1)
!endprocedure

!procedure $edit_validation_profile_dialog()
    $construct_validation_profile_form_dialog("Edit Validation Profile Dialog", "Save Profile", 0)
!endprocedure

