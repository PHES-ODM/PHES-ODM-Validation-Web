    ODM Version: | ^ODM version^

    !if ($is_csv_file)
        {! 
            ODM Table | ^Table^
        }    
    !else
        Tables
        {#
            Sheet Name | Table
            Sample | ^Table^
            lab | ^Table^
        }
    !endif

