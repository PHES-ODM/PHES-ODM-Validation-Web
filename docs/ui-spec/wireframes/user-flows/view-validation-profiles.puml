@startuml

!include ../screens.puml

(*) --> [User opens the tool]"
{{
    $home_page()
}}
" as home_page

home_page --> [User clicks on **View Validation Profiles** button]"
{{
    $view_validation_profiles_dialog()
}}
" as view_validation_profiles_dialog

view_validation_profiles_dialog --> [User clicks on the **Close** button and \
\n was on the **Home** screen] home_page

(*) --> [User is on the **View Dataset** screen]"
{{
    $view_dataset_page("Ontario Lab.csv", 0)
}}
" as view_dataset_page

view_dataset_page --> [User clicks on the **View Validation Profiles** \
button] view_validation_profiles_dialog

view_validation_profiles_dialog --> [User clicks on the **Close** button and \
\n was on the **View Dataset** screen] view_dataset_page

(*) --> [User is on the **Validation Summary** screen]"
{{
    $validation_summary_page()
}}
" as validation_summary_page

validation_summary_page --> [User clicks on the **View Validation Profiles** \
button] view_validation_profiles_dialog

view_validation_profiles_dialog --> [User clicks on the **Close** button and \
\n user was on the **Validation Summary Screen**] validation_summary_page

@enduml
